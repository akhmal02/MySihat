# MySihat - Environment Configuration Template
# Add your Supabase credentials into local.properties (which is excluded from Git via .gitignore)

# Supabase Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Publishable / Anon Key
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Storage Buckets in Supabase
SUPABASE_STORAGE_BUCKET_DOCS=medical-documents

# Application Environment Mode
APP_MODE=live
